#include? "Secrets.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.cascadiacollections.shoutkit
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SHOUTCAST_DEV_KEY =

// Short git commit the build was produced from, surfaced in Settings → About for
// screenshot-based bug repro. Defaults to "local"; CI and the deploy scripts pass
// the real value with `GIT_COMMIT_SHA=$(git rev-parse --short HEAD)`.
GIT_COMMIT_SHA = local
