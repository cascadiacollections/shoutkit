<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch app is a separate bundle and needs its own manifest: the iOS
	     app's PrivacyInfo.xcprivacy covers only Holmdel.app, and since #166 this
	     bundle ships embedded inside it at Watch/HolmdelWatchApp.app. Apple's
	     submission check (ITMS-91053) inspects each bundle, so an embedded app
	     without a declaration is flagged even when its host has one. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- UserDefaults.standard stores the last-played station so the
			     "Play Last" complication can render and act without the phone
			     (WatchAppDependencies, Keys.lastStation). App-local data only,
			     never shared off-device. Persistence is also linked here, and its
			     SettingsStore/DefaultsKey reach UserDefaults. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
