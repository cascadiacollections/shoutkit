.DS_Store
DerivedData/
build/
.build/
*.xcuserstate
xcuserdata/

# Local secrets. Copy the template and keep real keys untracked.
HolmdelApp/Config/Secrets.xcconfig

# DocC output for the MIT packages (site/api/index.html is hand-authored and
# stays tracked; site/api/docs/ is the merged archive built by
# .github/scripts/build-docs.sh).
site/api/*/

# Organizer archive exports. `Distribute App` writes these next to the repo
# root as "Holmdel <date> <time>/Products/...", which is inside the working
# tree and would otherwise show up as untracked on every archive.
Holmdel */
